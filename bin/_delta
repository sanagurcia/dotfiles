#!/bin/sh
# delta, told which background it is up against. Wraps every call: gitconfig's
# pager and diffFilter, and _dpick's previews and pager.
#
# Two reasons the plain binary will not do.
#
# delta reads BAT_THEME for syntax highlighting, and the one bat wants is newer
# than the bat delta bundles. delta warns, then falls back to its own default
# theme, which is a dark one. So a light diff came out with light backgrounds
# and Monokai's near-white code on top. Unset it and delta picks the theme from
# the mode itself: GitHub when light, Monokai when dark. That is the mapping we
# want, so there is no theme name to name here.
#
# And delta cannot work out the background for itself: inside tmux its OSC 11
# query cannot get out, and in an fzf preview stdout is redirected. So say which
# it is, from the one place that knows — see bin/theme.
exec env -u BAT_THEME delta "--$(_theme)" "$@"
