#!/usr/bin/env bash
# Browse a diff as a tree. ctrl-o views the picked file whole. The top row is the
# PR's description, when GitHub has one to give.
#
# Three things worth reviewing, so three modes, plus one filter:
#   (none)          this branch: _base...HEAD
#   -w/--worktree   the uncommitted changes: git diff HEAD, staged and unstaged
#   -c/--commit     one commit of the branch, picked if no SHA is given
#   -v/--verbose    keep the tests and locale files, otherwise left out
#
# ctrl-h brings the hidden files back inside the tree, and hides them again.
#
# Neither kind is usually why you opened the diff: tests are their own reading,
# and a translation file is a wall of strings a translator owns.

# Pathspecs, so _dpick and _dtree can hand them straight to git diff. They live
# here rather than there: which files are noise is this command's opinion, not
# the viewer's. Locale files all sit under a locales/ directory bar a stray or
# two, which are camelCased — hence icase, and the second pattern.
skip=':!*.test.* :!*.spec.* :!*_test.go
      :(exclude,icase)*locales/*.json :(exclude,icase)*translation*.json'

mode=branch sha=
while [ $# -gt 0 ]; do
  case $1 in
    -w|--worktree) mode=worktree ;;
    -c|--commit)   mode=commit ;;
    -v|--verbose)  skip= ;;
    -*) echo "usage: git review [-w|--worktree] [-c|--commit [SHA]] [-v|--verbose]" >&2
        exit 2 ;;
    *)  sha=$1 ;;
  esac
  shift
done
export DPICK_SKIP=$skip

# ctrl-o reads the picked file as it was in that commit. Without a SHA, pick one
# of the commits since main — the preview shows its message and stat. Hash first,
# so the picked line's SHA is field 1.
if [ "$mode" = commit ]; then
  if [ -z "$sha" ]; then
    # Five commits is enough to choose between; the stat preview takes the rest
    # of the screen. Three lines go to the prompt, the match counter and the
    # border.
    rows=$( { stty size </dev/tty; } 2>/dev/null | awk '{print $1}' )
    pv=70%
    [ -n "$rows" ] && [ "$rows" -gt 14 ] && pv=$(( rows - 8 ))
    sha=$(git log --color=always --format="%C(96)%h %Creset%s" "$(_base)..HEAD" |
      fzf --ansi -d' ' --layout=reverse --preview 'git show --stat --color=always {1}' \
          --preview-window "up,$pv,border-bottom" | awk '{print $1}')
    [ -n "$sha" ] || exit 0
  fi
  exec _dpick -r "$sha" "$sha^!"
fi

# Nothing is on GitHub yet for the worktree, so there is no description to fetch
# and no row to put it in — _dtree only draws one when DPICK_DOC is set.
[ "$mode" = worktree ] && exec _dpick -o HEAD

# gh is a network call: it can be slow, unauthenticated, or on a branch with no
# PR at all. Let it run alongside the tree rather than in front of it — the file
# fills in whenever it fills in, and staying empty is one of the answers.
doc=$(mktemp -t review-pr)
trap 'rm -f "$doc"' EXIT

# Only the description is worth reading here: everything from the release notes
# heading down is generated summary, so cut at that heading — any level, any
# case — and drop the blank lines left hanging off the end. GitHub's bodies come
# back with CRLF endings; the pager has no use for the CR.
gh pr view --json number,title,body \
   --template '{{printf "# #%v %v\n\n%v" .number .title .body}}' 2>/dev/null |
  awk '{ sub(/\r$/, "") }
       tolower($0) ~ /^#+[[:space:]]*release note/ { exit }
       /^[[:space:]]*$/ { blanks++; next }
       { while (blanks-- > 0) print ""; blanks = 0; print }' >"$doc" &

DPICK_DOC=$doc _dpick -o "$(_base)...HEAD"
