#!/usr/bin/env bash
# Browse this branch's diff as a tree. ctrl-o views the picked file whole. The
# top row is the PR's description, when GitHub has one to give.
#
# gh is a network call: it can be slow, unauthenticated, or on a branch with no
# PR at all. Let it run alongside the tree rather than in front of it — the file
# fills in whenever it fills in, and staying empty is one of the answers.
#
# -w/--worktree reviews the uncommitted changes instead: git diff HEAD, so staged
# and unstaged together. Nothing is on GitHub yet, so there is no description to
# fetch and no row to put it in — _dtree only draws one when DPICK_DOC is set.
case $1 in
  -w|--worktree) exec _dpick -o HEAD ;;
esac

doc=$(mktemp -t review-pr)
trap 'rm -f "$doc"' EXIT

# Only the description is worth reading here: everything from the release notes
# heading down is generated summary, so cut at that heading — any level, any
# case — and drop the blank lines left hanging off the end. GitHub's bodies come
# back with CRLF endings; the pager has no use for the CR.
gh pr view --json number,title,body \
   --template '{{printf "# #%v %v\n\n%v" .number .title .body}}' 2>/dev/null |
  awk '{ sub(/\r$/, "") }
       tolower($0) ~ /^#+[[:space:]]*release note/ { exit }
       /^[[:space:]]*$/ { blanks++; next }
       { while (blanks-- > 0) print ""; blanks = 0; print }' >"$doc" &

DPICK_DOC=$doc _dpick -o "$(_base)...HEAD"
