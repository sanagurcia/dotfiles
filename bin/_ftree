#!/usr/bin/env bash
# One directory as "display<TAB>path" rows for ft's list pane. Default is one
# level deep — the opened dir's immediate children — so a typed query only ever
# matches this level: fzf searches what it shows, and nothing deeper is shown.
# With a non-empty second argument ft asks for the deep view instead: the whole
# subtree as a folded tree, the way _dtree renders a diff, for a global search.
# ctrl-g flips between the two — see ft.
#
# Its own script so ft can hand it to fzf's reload and re-run it on a hop or a
# flip. fd rather than a glob, so .gitignore is honoured: a directory reads as
# its sources and not its build output. Paths are root-relative; ft cd's to the
# root first, so a reload lands there too. A directory keeps its trailing slash
# so ft can tell it from a file.
dir=${1:-.}; dir=${dir#./}; dir=${dir%/}; [ -z "$dir" ] && dir=.
deep=$2

# A row to climb out of the current root, unless it already is the top.
[ "$dir" = . ] || printf '\033[34m../\033[0m\t%s\n' "$(dirname "$dir")"

if [ -n "$deep" ]; then
  # Same width maths as _dtree; see it. Sort on a key that marks each component 0
  # for a directory and 1 for a file, so directories win every tie and a level's
  # files collect below its subtrees rather than scattering through them. _tree
  # folds single-child chains and lays the tree out to the pane.
  cols=${FZF_COLUMNS:-$( { stty size </dev/tty; } 2>/dev/null | awk '{print $2}' )}
  width=0
  [ -n "$cols" ] && width=$(( cols - cols * 75 / 100 - 3 ))
  fd -t f . "$dir" | sed 's|^\./||' |
    awk '{
      n = split($0, c, "/"); k = ""
      for (i = 1; i <= n; i++) k = k ((i < n) ? "0" : "1") c[i] "/"
      print k "\t" $0
    }' | sort | cut -f2- | _tree -v width=$width
else
  # Immediate children only: subdirectories first, then files, each by basename.
  fd -d 1 -t d . "$dir" | sed 's|^\./||' | sort |
    while IFS= read -r p; do printf '\033[34m%s/\033[0m\t%s/\n' "$(basename "$p")" "${p%/}"; done
  fd -d 1 -t f . "$dir" | sed 's|^\./||' | sort |
    while IFS= read -r p; do printf '%s\t%s\n' "$(basename "$p")" "$p"; done
fi
