#!/usr/bin/env bash
# Tier 1 (autarc-prep < autarc-up < autarc-dev): make a fresh worktree buildable.
# Enough to type-check, lint and run unit tests, full-stack. No env, no
# containers — api-v2 integration tests self-skip without a DB connection.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "==> pnpm install"
pnpm install --config.confirmModulesPurge=false
echo "==> pnpm lib:build"
pnpm lib:build
echo "✓ ready: check-types, lint, unit tests"
