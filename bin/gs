#!/usr/bin/env bash
# Browse a commit's diff as a tree. Without a SHA, pick one of the commits since
# main — the preview shows its message and stat. Hash first, so the picked line's
# SHA is field 1.
sha=$1
if [ -z "$sha" ]; then
  sha=$(git log --color=always --format="%C(96)%h %Creset%s" main..HEAD |
    fzf --ansi -d' ' --layout=reverse --preview 'git show --stat --color=always {1}' \
        --preview-window 'up,70%,border-bottom' | awk '{print $1}')
  [ -n "$sha" ] || exit 0
fi
_dpick "$sha^!"
