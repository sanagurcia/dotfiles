#!/usr/bin/env bash
# Browse a commit's diff as a tree; ctrl-o reads the picked file as it was in that
# commit. Without a SHA, pick one of the commits since main — the preview shows
# its message and stat. Hash first, so the picked line's SHA is field 1.
sha=$1
if [ -z "$sha" ]; then
  # Five commits is enough to choose between; the stat preview takes the rest of
  # the screen. Three lines go to the prompt, the match counter and the border.
  rows=$( { stty size </dev/tty; } 2>/dev/null | awk '{print $1}' )
  pv=70%
  [ -n "$rows" ] && [ "$rows" -gt 14 ] && pv=$(( rows - 8 ))
  sha=$(git log --color=always --format="%C(96)%h %Creset%s" main..HEAD |
    fzf --ansi -d' ' --layout=reverse --preview 'git show --stat --color=always {1}' \
        --preview-window "up,$pv,border-bottom" | awk '{print $1}')
  [ -n "$sha" ] || exit 0
fi
_dpick -r "$sha" "$sha^!"
