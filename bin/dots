#!/usr/bin/env bash
# Pull this repo and re-link; `exec zsh` to reload the shell config.
# Two homes: ~/dotfiles on the Mac, the coder config dir on a workspace, where
# `coder dotfiles` clones it.
for d in "$HOME/dotfiles" "$HOME/.config/coderv2/dotfiles"; do
  if [ -d "$d/.git" ]; then
    git -C "$d" pull -q && "$d/setup.sh" &&
      printf '\033[32m✓ dotfiles\033[0m\n'
    exit
  fi
done

coder dotfiles -y git@github.com:sanagurcia/dotfiles.git
