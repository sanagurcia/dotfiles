#!/usr/bin/env bash
# Tier 2: Postgres + migrations, for api-v2 integration tests.

# Self-sufficient in a fresh worktree: the setup pass claims a port slot and
# renders the env files supabase reads its project id and ports from. No
# service stack, no tailnet, no catalog import — that is autarc-up.
# Unattended on Coder (OP_SERVICE_ACCOUNT_TOKEN); on the Mac op may prompt.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> pnpm energy setup --no-services --no-tailscale"
pnpm energy setup --no-services --no-tailscale

echo "==> supabase start (db only)"
pnpm supabase --workdir apps start -x gotrue,kong   # devenv.SupabaseExcludes
echo "==> pnpm db:push"
pnpm db:push

# Read the port only now: a fresh worktree has no ports.env until setup writes it.
port=54322
if [ -f .worktree/ports.env ]; then
  port=$(sed -n 's/^WT_SB_DB_PORT=//p' .worktree/ports.env)
fi
echo "✓ db up on :$port"
echo "  integration tests: SUPABASE_CONNECTION_STRING=postgres://postgres:postgres@localhost:$port/postgres make test"
