#!/usr/bin/env bash
# ft's Enter action, printed for fzf to run through transform: page a file in
# bat, or hop the tree into a directory — reloading _ftree there and moving the
# header to match. Its own script so the bind string stays a bare transform(...)
# call, free of the nested parens and quotes fzf's action parser trips over when
# the whole thing is spelled inline.
p=$1
if [ -d "$p" ]; then
  printf 'reload(_ftree %q)+pos(1)+change-header(%s)' "$p" "${p%/}"
else
  printf 'execute(_bat-at %q)' "$p"
fi
