#!/bin/sh
# Prints light or dark: the one fact every colour-aware script here asks for.
#
# A file rather than an exported variable, and read at each call: a shell that
# started this morning, and the fzf session it is running, both see a toggle
# from another pane. `theme` writes it; nothing else does.
#
# No terminal query here on purpose. This runs inside fzf previews and in the
# middle of pipes, where there is no tty to ask, and it runs often enough that
# a round trip would be felt. `theme detect` owns the asking, and always leaves
# a value behind, so the file exists by the time anything reads it.
f=${THEME_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/theme}
read -r t 2>/dev/null <"$f" || t=
case $t in
  light|dark) printf %s "$t" ;;
  *)          printf dark ;;
esac
