#!/usr/bin/env bash
# Pick a hit (file[:line:...]) from stdin, then browse the directory it lives in
# with the file itself open on the right. fs, ff and defs all end up here.
sel=$(fzf --ansi -d: --preview '_bat-at {1} {2}' --preview-window 'up,70%,border-bottom,+{2}-/3') || exit 0
IFS=: read -r file line _ <<<"$sel"
_fpick "$file" "$line"
