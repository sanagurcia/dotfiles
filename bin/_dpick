#!/usr/bin/env bash
# Browse a diff as a tree: files and directories on the left, that path's diff on
# the right. The remaining args are git-diff's revisions.
#
# ctrl-o reads the picked file whole, from wherever makes sense for the diff being
# browsed: -o takes it from the working tree, -r REV out of that revision. bat
# infers the syntax from --file-name, since the blob arrives on a pipe unnamed.
#
# ctrl-h brings back whatever the caller asked to hide, and hides it again; ctrl-l
# toggles delta's line numbers.
#
# Enter runs the pager through fzf's execute rather than accepting, so quitting it
# returns to the tree instead of ending the interface. Esc is the way out.
# git diff prints paths from the root of the working tree but resolves a pathspec
# against the current directory, so every preview would come up empty when run
# from a subdirectory. Move to the root and they agree; children inherit it, so
# the reload below lands there too.
cd "$(git rev-parse --show-toplevel)" || exit

# Start with delta's line numbers on, as gitconfig has them, and let ctrl-l take
# them away for the preview and the pager alike. delta has no --line-numbers=false
# and a feature cannot override the main [delta] section, so "off" is both number
# formats blanked. The state is a file because every preview and every execute
# binding is its own shell.
off="--line-numbers-left-format= --line-numbers-right-format="
nums=$(mktemp -t dpick-nums.XXXXXX) # holding $off: numbers off, empty: on
numflag="\$(cat $nums)"

# git-review's DPICK_SKIP holds the pathspecs it leaves out. Same idea, one file
# down: _ddiff and _dtree read the hidden set out of it on every call, so ctrl-h
# can empty it and put it back — the whole interface then agrees on what is
# hidden, tree, stat and diffs alike.
hide=$(mktemp -t dpick-hide.XXXXXX) # holding $DPICK_SKIP: hidden, empty: all shown
export DPICK_HIDE=$hide
trap 'rm -f "$nums" "$hide"' EXIT
: > "$nums"
printf %s "$DPICK_SKIP" > "$hide"
show="[ -s $hide ] && : > $hide || printf %s \"\$DPICK_SKIP\" > $hide"

open=()
case $1 in
  -o) open=(--bind 'ctrl-o:execute([ {2} = @pr ] || _bat-at {2})'); shift ;;
  -r) rev=$2; shift 2
      open=(--bind "ctrl-o:execute([ {2} = @pr ] || git show $rev:{2} | bat --color=always --file-name {2} --paging=always --pager \"less -R\")") ;;
esac

# delta cannot work out the background for itself here: stdout is redirected in
# an fzf preview, and inside tmux its OSC 11 query cannot get out either. So say
# which it is. macOS follows the system setting, as batconfig's auto:system does
# for bat; elsewhere — the coder workspace — dark.
if command -v defaults >/dev/null; then
  mode=--light
  [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ] && mode=--dark
else
  mode=--dark
fi

# {2} is the real path; --with-nth 1 hides it and shows the tree column only.
# gitconfig sets delta's navigate, whose hunk-header box draws a stub of a second
# vertical rule right beside the preview's own border; drop it here. The pager
# keeps it — there it is the only border, and navigate is actually usable.
diffprev="_ddiff $* -- {2} | delta $mode --24-bit-color=always --paging=never \
  --hunk-header-decoration-style=none --width=\$FZF_PREVIEW_COLUMNS $numflag"

# _dtree's PR row carries a sentinel path rather than a real one: show the
# description, not a diff of it. _prdoc fetches on demand and says so itself when
# there is no PR, so there is nothing to test for here.
#
# bat's wrap=auto is never when its output is a pipe, and a description is prose
# that runs well past the pane — so fold it first, at spaces rather than mid-word
# as bat and less both would. The width comes from whoever has one: fzf's pane
# for the preview, the terminal for the pager.
docprev="_prdoc | fold -s -w \$FZF_PREVIEW_COLUMNS \
  | bat --color=always --style=plain --language=md --paging=never"
preview="if [ {2} = @pr ]; then $docprev; else $diffprev; fi"

# The stat counts only what is on show, so ctrl-h has to redraw it too — hence
# a script rather than a string, for transform-header to re-run.
header=$(_dstat "$@")

_dtree "$@" |
  fzf --ansi -d'\t' --with-nth 1 --layout=reverse --no-scrollbar --track \
      --header "$header" \
      --bind "resize:reload(_dtree $*)" \
      --preview "$preview" --preview-window 'right,75%,border-left' \
      --bind "enter:execute(if [ {2} = @pr ]; then _prdoc | fold -s -w \"\$(tput cols)\" | bat --color=always --style=plain --language=md --paging=always --pager 'less -R'; else _ddiff $* -- {2} | delta $mode --paging=always $numflag; fi)" \
      --bind "ctrl-h:execute-silent($show)+reload(_dtree $*)+refresh-preview+transform-header(_dstat $*)" \
      --bind "ctrl-l:execute-silent([ -s $nums ] && : > $nums || printf %s '$off' > $nums)+refresh-preview" \
      "${open[@]}"
