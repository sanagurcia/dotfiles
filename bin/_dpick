#!/usr/bin/env bash
# Browse a diff as a tree: files and directories on the left, that path's diff on
# the right. The remaining args are git-diff's revisions.
#
# ctrl-o reads the picked file whole, from wherever makes sense for the diff being
# browsed: -o takes it from the working tree, -r REV out of that revision. bat
# infers the syntax from --file-name, since the blob arrives on a pipe unnamed.
#
# Enter runs the pager through fzf's execute rather than accepting, so quitting it
# returns to the tree instead of ending the interface. Esc is the way out.
# git diff prints paths from the root of the working tree but resolves a pathspec
# against the current directory, so every preview would come up empty when run
# from a subdirectory. Move to the root and they agree; children inherit it, so
# the reload below lands there too.
cd "$(git rev-parse --show-toplevel)" || exit

# gitconfig turns delta's line numbers on, which is what we want for reading and
# in the way for copying a hunk out. ctrl-l toggles them, for the preview and the
# pager alike. delta has no --line-numbers=false and a feature cannot override the
# main [delta] section, so "off" is both number formats blanked. The state is a
# file because every preview and every execute binding is its own shell.
nums=$(mktemp -t dpick-nums) # empty: numbers on
trap 'rm -f "$nums"' EXIT
off="--line-numbers-left-format= --line-numbers-right-format="
numflag="\$(cat $nums)"

open=()
case $1 in
  -o) open=(--bind 'ctrl-o:execute(_bat-at {2})'); shift ;;
  -r) rev=$2; shift 2
      open=(--bind "ctrl-o:execute(git show $rev:{2} | bat --color=always --file-name {2} --paging=always)") ;;
esac

# delta only queries the terminal for its background when it is not redirected,
# and an fzf preview always is — so it would assume dark. Follow the macOS
# setting ourselves, as batconfig's auto:system does for bat. Not macOS: light.
# The execute bindings get a real terminal, so they need no flag.
mode=--light
[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ] && mode=--dark

# {2} is the real path; --with-nth 1 hides it and shows the tree column only.
# gitconfig sets delta's navigate, whose hunk-header box draws a stub of a second
# vertical rule right beside the preview's own border; drop it here. The pager
# keeps it — there it is the only border, and navigate is actually usable.
preview="git diff $* -- {2} | delta $mode --24-bit-color=always --paging=never \
  --hunk-header-decoration-style=none --width=\$FZF_PREVIEW_COLUMNS $numflag"

header=$(git diff --shortstat "$@" | awk '{
  for (k = 1; k < NF; k++) {
    if ($(k+1) ~ /^insertion/) ins = $k
    if ($(k+1) ~ /^deletion/)  del = $k
  }
  printf "%s files  \033[32m+%d\033[0m \033[31m-%d\033[0m  \033[90mctrl-l numbers\033[0m", $1, ins, del
}')

_dtree "$@" |
  fzf --ansi -d'\t' --with-nth 1 --layout=reverse --no-scrollbar --track \
      --header "$header" \
      --bind "resize:reload(_dtree $*)" \
      --preview "$preview" --preview-window 'right,75%,border-left' \
      --bind "enter:execute(git diff $* -- {2} | delta --paging=always $numflag)" \
      --bind "ctrl-l:execute-silent([ -s $nums ] && : > $nums || printf %s '$off' > $nums)+refresh-preview" \
      "${open[@]}"
