[user]
	email = santiago@autarc.energy 
	name = Santiago Agurcia

[init]
	defaultBranch = main

[alias]
	co = checkout
	st = status
	br = branch
	cm = commit -m
	amend = commit -a --amend --no-edit
	undo = !git reset --hard && git clean -f -d
	ignore = update-index --assume-unchanged

[pull]
	ff = only

[core]
	pager = delta
	editor = nano

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
